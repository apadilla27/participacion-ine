# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.
# Todas las lecturas a Supabase ocurren en el servidor (build / ISR), por eso ninguna variable lleva NEXT_PUBLIC_.

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_...). Si el proyecto solo muestra claves heredadas, usa la "anon" key.
SUPABASE_PUBLISHABLE_KEY=

# Cadena aleatoria de al menos 16 caracteres. Vercel la envía como "Authorization: Bearer <CRON_SECRET>" al cron de keepalive.
CRON_SECRET=
