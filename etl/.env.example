# Copia este archivo como etl/.env (está en .gitignore). Lo lee etl/load.py.
# Supabase → botón "Connect" → Session pooler. Debe ser el pooler (IPv4, puerto 5432);
# la conexión directa db.<ref>.supabase.co es solo IPv6 en el plan Free.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
