# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!etl/.env.example

# ETL (entorno Python y salidas locales; los agregados viven fuera de OneDrive)
etl/.venv/
etl/__pycache__/
etl/out/
*.duckdb
*.duckdb.wal

# Impeccable (overrides locales por desarrollador y caché del detector)
# El binario del motor (19 MB) no se versiona: el lanzador lo descarga del release
# oficial y verifica su SHA-256 si falta (ver .cursor/skills/impeccable/scripts/impeccable.cmd).
.cursor/skills/impeccable/scripts/bin/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/review/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
